# Contributor: Ted To <wintrymix@theo.to>

pkgname="brlaser"
pkgver=2a49e32
pkgrel=1
pkgdesc="Brother laser printer driver"
arch=('x86_64' 'armv7h' 'aarch64')
url="https://github.com/Owl-Maintain/brlaser"
license=('GPL-2.0-or-later')
depends=('cups' 'ghostscript')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::https://github.com/pdewacht/brlaser/archive/refs/heads/master.tar.gz")
sha512sums=('SKIP')

build() {
    local cmake_options=(
        -B build
        -S "$pkgname-master"
        -Wno-dev
        -DCMAKE_BUILD_TYPE=None
        -DCMAKE_INSTALL_PREFIX=/usr
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    )
    cmake "${cmake_options[@]}"
    cmake --build build
}

check() {
	local ctest_flags=(
		--test-dir build
		--output-on-failure
		--parallel $(nproc)
	)
	ctest "${ctest_flags[@]}"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
