#!/bin/bash

set -euo pipefail

SYMLINK_DIR="$HOME/.local/bin"
PROFILES_DIR="$HOME/.local/share/bwrapjail/profiles"

source "$HOME/.local/share/bwrapjail/lib/utils.sh"

case "${1:-}" in
    run)
        shift
        if [ $# -lt 1 ]; then
            log ERROR "run requires <program> [args...]"
            show_usage 1
        fi
        CMD=( "$@" )
        CMD_PATH="${CMD[0]}"
        CMD_NAME="$(basename "$CMD_PATH")"
        ;;

    generate)
        shift
        check_dependencies || exit 1
        generate_symlinks "$1"
        exit 0
        ;;

    list)
        list_profiles
        exit 0
        ;;

	*)
	    show_usage 1
	    ;;
esac

# -----------------------------
# PROFILE VALIDATION
# -----------------------------

check_dependencies || exit 1

PROFILE_FILE="$(get_profile_from_cmd "$CMD_NAME" "$CMD_PATH")"

if [[ -z "$PROFILE_FILE" || ! -f "$PROFILE_FILE" ]]; then
    log ERROR "No profile matches command: $CMD_NAME ($CMD_PATH)"
    exit 1
fi

log INFO "Using profile: $CMD_NAME"

# -----------------------------
# LOAD PROFILE ONCE (BIG WIN)
# -----------------------------

PROFILE_JSON="$(<"$PROFILE_FILE")"

# Extract everything in ONE jq call
read -r ALLOW_GPU ALLOW_WAYLAND ALLOW_X11 \
        ALLOW_NETWORK NETWORK_ISOLATED \
        ALLOW_DBUS \
        ALLOW_OPEN_URI ALLOW_FILE_CHOOSER ALLOW_PRINT \
        ALLOW_NOTIFICATIONS ALLOW_SCREENSHARE ALLOW_CLIPBOARD <<EOF
$(jq -r '
    .graphics.gpu,
    .graphics.wayland,
    .graphics.x11,
    .network.enabled,
    .network.isolated,
    .dbus.enabled,
    .dbus.portals.open_uri,
    .dbus.portals.filechooser,
    .dbus.portals.print,
    .dbus.portals.notifications,
    .dbus.portals.screenshare,
    .dbus.portals.clipboard
' <<< "$PROFILE_JSON")
EOF

# -----------------------------
# BUILD BWRAP COMMAND
# -----------------------------

log INFO "Building bwrap command"

BWRAP_ARGS=(
    bwrap
    --uid 1000
    --gid 1000
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --bind /usr/bin/xdg-open /usr/bin/xdg-open
)

# -----------------------------
# PATHS
# -----------------------------

log INFO "Loading sandbox paths"

while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue

    mode=${entry%%:*}
    path=${entry#*:}

    path=${path/#\~/$HOME}
    path=${path//\$HOME/$HOME}

    case $path in
        /dev*|/proc*)
            log WARN "Skipping managed mount: $path"
            continue
            ;;
    esac

    case $mode in
        ro)
            log INFO "Adding read-only bind: $path"
            add_bwrap_arg --ro-bind "$path" "$path"
            ;;
        rw)
            log INFO "Adding read-write bind: $path"
            add_bwrap_arg --bind "$path" "$path"
            ;;
        tmpfs)
            log WARN "Skipping tmpfs mount (managed by bwrapjail)"
            add_bwrap_arg --tmpfs "$path"
            ;;
        *)
            log ERROR "Invalid mode '$mode' in entry: $entry"
            exit 1
            ;;
    esac
done < <(jq -r '.paths[]?' <<< "$PROFILE_JSON")

# -----------------------------
# DISPLAY / GRAPHICS
# -----------------------------

if [[ "$ALLOW_GPU" == "true" ]]; then
    log INFO "Enabling GPU access"
    add_bwrap_arg --dev-bind-try /dev/nvidia* /dev/nvidia*
    add_bwrap_arg --dev-bind-try /dev/kfd /dev/kfd
    add_bwrap_arg --ro-bind-try /sys/class/drm /sys/class/drm
    add_bwrap_arg --dev-bind /dev/dri /dev/dri
fi

if [[ "$ALLOW_WAYLAND" == "true" && -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    log INFO "Enabling Wayland display"
    add_bwrap_arg --bind "$XDG_RUNTIME_DIR" "$XDG_RUNTIME_DIR"
    add_bwrap_arg --bind "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" \
                  "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
fi

if [[ "$ALLOW_X11" == "true" && -n "${DISPLAY:-}" ]]; then
    log INFO "Enabling X11 socket"
    add_bwrap_arg --bind /tmp/.X11-unix /tmp/.X11-unix
fi

# -----------------------------
# AUDIO
# -----------------------------

if [[ -d "${XDG_RUNTIME_DIR:-}/pulse" ]]; then
    log INFO "Enabling PulseAudio"
    add_bwrap_arg --bind "$XDG_RUNTIME_DIR/pulse" "$XDG_RUNTIME_DIR/pulse"
fi

# -----------------------------
# NETWORK
# -----------------------------

if [[ "$ALLOW_NETWORK" == "true" && "$NETWORK_ISOLATED" == "false" ]]; then
    log INFO "Allow network, not isolated"
    add_bwrap_arg --share-net

elif [[ "$ALLOW_NETWORK" == "true" && "$NETWORK_ISOLATED" == "true" ]]; then
    log INFO "Network enabled (isolated)"
    add_bwrap_arg --unshare-user
else
    log INFO "Network disabled"
    add_bwrap_arg --unshare-net
fi

# -----------------------------
# ENVIRONMENT VARIABLES
# -----------------------------

log INFO "Loading environment variables"

jq -r '.envs[]?' <<< "$PROFILE_JSON" | while IFS= read -r line; do
    [[ -z "$line" ]] && continue

    key="${line%%=*}"
    value="${line#*=}"

    log INFO "ENV: $key=$value"
    add_bwrap_arg --setenv "$key" "$value"
done

# -----------------------------
# DBUS
# -----------------------------

DBUS_PROXY_PID=""

if [[ "$ALLOW_DBUS" == "true" ]]; then
    log INFO "Setting up D-Bus proxy"

    PROXY_SOCKET="$XDG_RUNTIME_DIR/bus-proxy-$(uuidgen).sock"
    PROXY_ARGS=()

    add_portal() {
        [[ "${2:-}" == "true" ]] && PROXY_ARGS+=( --talk="$1" )
    }

    add_portal org.freedesktop.portal.OpenURI "$ALLOW_OPEN_URI"
    add_portal org.freedesktop.portal.FileChooser "$ALLOW_FILE_CHOOSER"
    add_portal org.freedesktop.portal.Print "$ALLOW_PRINT"
    add_portal org.freedesktop.portal.Notification "$ALLOW_NOTIFICATIONS"
    add_portal org.freedesktop.portal.ScreenCast "$ALLOW_SCREENSHARE"
    add_portal org.freedesktop.portal.Clipboard "$ALLOW_CLIPBOARD"

    xdg-dbus-proxy \
        "$DBUS_SESSION_BUS_ADDRESS" \
        "$PROXY_SOCKET" \
        --filter \
        "${PROXY_ARGS[@]}" &

    DBUS_PROXY_PID=$!

    add_bwrap_arg --bind "$XDG_RUNTIME_DIR" "$XDG_RUNTIME_DIR"
    add_bwrap_arg --setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$XDG_RUNTIME_DIR/bus"
else
    log INFO "DBus disabled entirely"
fi

# -----------------------------
# RUN
# -----------------------------

add_bwrap_arg -- "${CMD[@]}"

log INFO "Command: ${BWRAP_ARGS[*]}"

BWRAP_PID=""

cleanup() {
    log INFO "Cleaning up"
    [[ -n "${BWRAP_PID:-}" ]] && kill "$BWRAP_PID" 2>/dev/null || true
    [[ -n "${DBUS_PROXY_PID:-}" ]] && kill "$DBUS_PROXY_PID" 2>/dev/null || true
    [[ -n "${PROXY_SOCKET:-}" ]] && rm -f "$PROXY_SOCKET"
}

trap cleanup EXIT INT TERM

if [[ "$ALLOW_NETWORK" == "true" && "$NETWORK_ISOLATED" == "true" ]]; then
    log INFO "Launching sandbox via pasta"

    pasta \
        --config-net \
        --dns none \
        --no-map-gw \
        -- \
        "${BWRAP_ARGS[@]}" 2> >(while read -r line; do log ERROR "$line"; done) &

    BWRAP_PID=$!
else
    log INFO "Launching sandbox"

    "${BWRAP_ARGS[@]}" 2> >(while read -r line; do log ERROR "$line"; done) &
    BWRAP_PID=$!
fi

wait "$BWRAP_PID"
