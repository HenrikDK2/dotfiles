#!/usr/bin/env bash
set -euo pipefail

# Get active monitor resolution from Hyprland
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  read -r OUT_W OUT_H < <(
    hyprctl monitors -j | jq -r '
      .[] | select(.focused == true) | "\(.width) \(.height)"
    '
  )
fi

OUT_W="${OUT_W:-2560}"
OUT_H="${OUT_H:-1440}"

GAME_W="$OUT_W"
GAME_H="$OUT_H"

# Optional override: 1920x1080 %command%
if [[ "${1:-}" =~ ^[0-9]+x[0-9]+$ ]]; then
  OUT_W="${1%x*}"
  OUT_H="${1#*x}"
  GAME_W="$OUT_W"
  GAME_H="$OUT_H"
  shift
fi

exec gamescope \
  -W "$OUT_W" -H "$OUT_H" \
  -w "$GAME_W" -h "$GAME_H" \ 
  --force-grab-cursor -- \
  ionice -c 2 -n 0 \
  nice -n -11 "$@"
