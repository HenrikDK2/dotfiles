	--talk=org.freedesktop.portal.Desktop
    --talk=org.freedesktop.portal.FileChooser
	--talk=org.freedesktop.portal.OpenURI
	--talk=org.freedesktop.portal.Notification
	--talk=org.freedesktop.portal.Clipboard
	--talk=org.freedesktop.portal.Print
	--talk=org.freedesktop.portal.ScreenCast
	#--talk=org.freedesktop.portal.RemoteDesktop
	#--talk=org.freedesktop.portal.Settings
	#--talk=org.freedesktop.portal.AppChooser
	#--talk=org.freedesktop.portal.Camera
	#--talk=org.freedesktop.portal.Location
	#--talk=org.freedesktop.portal.InputCapture
	#--talk=org.freedesktop.portal.Secret
	#--talk=org.freedesktop.portal.Account
	#--talk=org.freedesktop.portal.Inhibit
	#--talk=org.freedesktop.portal.DynamicLauncher
	#--talk=org.freedesktop.portal.GameMode
	#--talk=org.freedesktop.portal.Realtime
	#--talk=org.kde.StatusNotifierWatcher
	#--talk=org.a11y.Bus
	#--talk=org.mpris.MediaPlayer2.*
	#--talk=org.gnome.SessionManager
	#--talk=org.freedesktop.PowerManagement
	#--talk=org.freedesktop.login1
	#--talk=org.freedesktop.systemd1
	#--talk=org.freedesktop.impl.portal.PermissionStore
