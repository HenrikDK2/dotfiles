BWRAP_ARGS=(
	--new-session
	--clearenv
	--unshare-all
	--share-net
	--hostname mypc

	# FS
	--proc /proc
	--dev /dev
	--tmpfs /tmp
	--tmpfs /run

	# Binds
	--bind-try $HOME/.cache $HOME/.cache
	--bind-try $HOME/.cache/fontconfig $HOME/.cache/fontconfig
	--bind-try $HOME/.config/dconf/user $HOME/.config/dconf/user
	--bind-try $HOME/.config/gtk-3.0 $HOME/.config/gtk-3.0
	--bind-try $HOME/.config/lsfg-vk/conf.toml $HOME/.config/lsfg-vk/conf.toml
	--bind-try $HOME/.config/mimeapps.list $HOME/.config/mimeapps.list
	--bind-try $HOME/.config/mozilla/firefox $HOME/.config/mozilla/firefox
	--bind-try $HOME/.config/pulse/cookie $HOME/.config/pulse/cookie
	--bind-try $HOME/Downloads $HOME/Downloads
	--bind-try $HOME/.icons $HOME/.icons
	--bind-try $HOME/.local/share/applications/mimeinfo.cache $HOME/.local/share/applications/mimeinfo.cache
	--bind-try $HOME/.local/share/flatpak $HOME/.local/share/flatpak
	--bind-try $HOME/.local/share/gvfs-metadata/root $HOME/.local/share/gvfs-metadata/root
	--bind-try $HOME/.local/share/icons $HOME/.local/share/icons
	--bind-try $HOME/.local/share/mime $HOME/.local/share/mime
	--bind-try $HOME/.local/share/vulkan $HOME/.local/share/vulkan
	--bind-try $HOME/.pulse-cookie $HOME/.pulse-cookie
	--bind-try $HOME/.themes $HOME/.themes

	--bind-try /tmp/.X11-unix/X0 /tmp/.X11-unix/X0
	--ro-bind-try /bin/dbus-launch /bin/dbus-launch
	--ro-bind-try /bin/firefox /bin/firefox
	--ro-bind-try /bin/sh /bin/sh

	--ro-bind-try /etc/ca-certificates /etc/ca-certificates
	--ro-bind-try /etc/fonts /etc/fonts
	--ro-bind-try /etc/gai.conf /etc/gai.conf
	--ro-bind-try /etc/host.conf /etc/host.conf
	--ro-bind-try /etc/hosts /etc/hosts
	--ro-bind-try /etc/ld.so.cache /etc/ld.so.cache
	--ro-bind-try /etc/ld.so.conf /etc/ld.so.conf
	--ro-bind-try /etc/ld.so.conf.d/lib32-glibc.conf /etc/ld.so.conf.d/lib32-glibc.conf
	--ro-bind-try /etc/libva.conf /etc/libva.conf
	--ro-bind-try /etc/localtime /etc/localtime
	--ro-bind-try /etc/machine-id /etc/machine-id
	--ro-bind-try /etc/mailcap /etc/mailcap
	--ro-bind-try /etc/mime.types /etc/mime.types
	--ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf
	--ro-bind-try /etc/os-release /etc/os-release
	--ro-bind-try /etc/passwd /etc/passwd
	--ro-bind-try /etc/pulse/client.conf /etc/pulse/client.conf
	--ro-bind-try /etc/resolv.conf /etc/resolv.conf
	--ro-bind-try /etc/xdg /etc/xdg

	--ro-bind-try /lib /lib

	--ro-bind-try /lib64 /lib64

	--ro-bind-try /sys/bus/pci/devices /sys/bus/pci/devices
	--ro-bind-try /sys/bus/pci_express /sys/bus/pci_express
	--ro-bind-try /sys/class/drm /sys/class/drm
	--ro-bind-try /sys/dev/char /sys/dev/char
	--ro-bind-try /sys/devices /sys/devices
	--ro-bind-try /sys/dri /sys/dri

	--ro-bind-try /usr/bin/bash /usr/bin/bash
	--ro-bind-try /usr/bin/dbus-launch /usr/bin/dbus-launch
	--ro-bind-try /usr/bin/env /usr/bin/env
	--ro-bind-try /usr/bin/firefox /usr/bin/firefox
	--ro-bind-try /usr/bin/gtk-query-immodules-3.0 /usr/bin/gtk-query-immodules-3.0
	--ro-bind-try /usr/bin/sh /usr/bin/sh
	--ro-bind-try /usr/bin/xdg-open /usr/bin/xdg-open
	--ro-bind-try /usr/lib /usr/lib
	--ro-bind-try /usr/lib32 /usr/lib32
	--ro-bind-try /usr/lib64 /usr/lib64
	--ro-bind-try /usr/local/share/fonts /usr/local/share/fonts
	--ro-bind-try /usr/share/applications/mimeinfo.cache /usr/share/applications/mimeinfo.cache
	--ro-bind-try /usr/share/ca-certificates /usr/share/ca-certificates
	--ro-bind-try /usr/share/drirc.d /usr/share/drirc.d
	--ro-bind-try /usr/share/fontconfig /usr/share/fontconfig
	--ro-bind-try /usr/share/fonts /usr/share/fonts
	--ro-bind-try /usr/share/glib-2.0 /usr/share/glib-2.0
	--ro-bind-try /usr/share/glvnd /usr/share/glvnd
	--ro-bind-try /usr/share/gtk-3.0 /usr/share/gtk-3.0
	--ro-bind-try /usr/share/icons /usr/share/icons
	--ro-bind-try /usr/share/libdrm /usr/share/libdrm
	--ro-bind-try /usr/share/locale /usr/share/locale
	--ro-bind-try /usr/share/mime /usr/share/mime
	--ro-bind-try /usr/share/pixmaps /usr/share/pixmaps
	--ro-bind-try /usr/share/themes/Default/gtk-3.0 /usr/share/themes/Default/gtk-3.0
	--ro-bind-try /usr/share/vulkan /usr/share/vulkan
	--ro-bind-try /usr/share/xkeyboard-config-2 /usr/share/xkeyboard-config-2
	--ro-bind-try /usr/share/zoneinfo /usr/share/zoneinfo

	--ro-bind-try /var/cache/fontconfig /var/cache/fontconfig
	--ro-bind-try /var/lib/dbus/machine-id /var/lib/dbus/machine-id
	--dev-bind-try /dev/dri /dev/dri
	--dev-bind-try /dev/kfd /dev/kfd
	--dev-bind-try /dev/shm /dev/shm

	--dev-bind-try /run/dbus/system_bus_socket /run/dbus/system_bus_socket
	--dev-bind-try /run/systemd/userdb/io.systemd.DynamicUser /run/systemd/userdb/io.systemd.DynamicUser
	--dev-bind-try /run/user/1000/bus /run/user/1000/bus
	--dev-bind-try /run/user/1000/dconf/user /run/user/1000/dconf/user
	--dev-bind-try /run/user/1000/pulse/native /run/user/1000/pulse/native
	--dev-bind-try /run/user/1000/wayland-1 /run/user/1000/wayland-1

	--setenv HOME $HOME
	
	--setenv DISPLAY $DISPLAY
	--setenv XDG_SESSION_TYPE $XDG_SESSION_TYPE
	--setenv XDG_CURRENT_DESKTOP $XDG_CURRENT_DESKTOP
	--setenv WAYLAND_DISPLAY $WAYLAND_DISPLAY
	--setenv XDG_RUNTIME_DIR $XDG_RUNTIME_DIR
)

utils::run "$@"
