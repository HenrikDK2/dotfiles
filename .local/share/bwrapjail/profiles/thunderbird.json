{
	"executable": "/usr/bin/thunderbird",
	"network": {
		"enabled": true,
		"isolated": false
	},

	"security": {
		"user_namespaces": true
	},

	"graphics": {
		"gpu": true,
		"wayland": true,
		"x11": true
	},

	"audio": {
		"enabled": true
	},

	"dbus": {
		"open_uri": true,
		"notifications": true,
		"screenshare": false,
		"file_picker": true,
		"print": true,
		"media": false,
		"clipboard": true
	},

	"paths": [
		"rw:$HOME/.thunderbird",
		"rw:$HOME/.config/thunderbird",
		"rw:$HOME/.cache/thunderbird",

		"ro:/run/user/1000",
		"ro:/sys",
		"ro:/bin",
		"ro:/sbin",
		"ro:/usr",
		"ro:/opt/thunderbird",
		"ro:/lib",
		"ro:/lib64",
		"ro:/etc"
	],
	"envs": []
}
