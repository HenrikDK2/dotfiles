{
	"cmd": {
		"executable": "/usr/bin/thunderbird",
		"extra_args": []
	},
	"allow_network": true,
	"allow_audio": true,
	"graphics": {
		"allow_gpu": true,
		"allow_wayland": true,
		"allow_x11": true
	},
	"dbus": {
		"open_uri": true,
		"notifications": true,
		"screenshare": false,
		"file_chooser": true,
		"print": true,
		"media": false,
		"clipboard": true
	},
	"paths": [
		"rw:$HOME/Downloads",
		"rw:$HOME/.thunderbird",
		"rw:$HOME/.config/thunderbird",
		"rw:$HOME/.config/mesa_shader_cache",
		"rw:$HOME/.cache/thunderbird",

		"rw:/var/cache/fontconfig",
		"rw:/usr/share/fontconfig",

		"ro:/usr/bin/thunderbird",

		"ro:/usr/share/fonts",
		"ro:/usr/share/icons",
		"ro:/usr/share/cursors",
		"ro:/usr/share/mime",
		"ro:/usr/share/locale",
		"ro:/usr/share/zoneinfo",
		"ro:/usr/share/mozilla",
		"ro:/usr/share/fontconfig",
		"ro:/usr/share/applications",
		"ro:/usr/share/glycin-loaders",
		"ro:/usr/share/huiespell",
		"ro:/usr/share/themes",
		"ro:/usr/share/xkeyboard-config-2",
		"ro:/usr/share/glib-2.0",
		"ro:/usr/share/gtk-3.0",
		"ro:/usr/share/pixmaps",
		"ro:/usr/share/ca-certificates",

		"ro:/usr/lib",
		"ro:/usr/lib64",

		"ro:/bin",
		"ro:/lib",
		"ro:/lib64",
		"ro:/etc"
	],
	"envs": {}
}
