{
	"cmd": {
		"executable": "/usr/bin/firefox",
		"extra_args": []
	},
	"allow_network": true,
	"allow_audio": true,
	"graphics": {
		"allow_gpu": true,
		"allow_wayland": true,
		"allow_x11": true
	},
	"dbus": {
		"open_uri": true,
		"notifications": true,
		"screenshare": true,
		"file_chooser": true,
		"print": true,
		"media": true,
		"clipboard": true
	},
	"paths": [
		"rw:$HOME/.config/dconf/user",
		"rw:$HOME/.cache/fontconfig",
		"rw:$HOME/.config/gtk-3.0/settings.ini",
		"rw:$HOME/Downloads",
		"rw:$HOME/.config/mozilla",
		"rw:$HOME/.cache/mozilla",

		"ro:/usr/bin/firefox",
		"ro:/usr/bin/sh",
		"ro:/usr/lib",
		"ro:/usr/lib64",

		"ro:/usr/share/fonts",
		"ro:/usr/share/icons",
		"ro:/usr/share/cursors",
		"ro:/usr/share/mime",
		"ro:/usr/share/locale",
		"ro:/usr/share/zoneinfo",
		"ro:/usr/share/mozilla",
		"ro:/usr/share/fontconfig",
		"ro:/usr/share/applications",
		"ro:/usr/share/glycin-loaders",
		"ro:/usr/share/huiespell",
		"ro:/usr/share/themes",
		"ro:/usr/share/xkeyboard-config-2",
		"ro:/usr/share/glib-2.0",
		"ro:/usr/share/gtk-3.0",
		"ro:/usr/share/pixmaps",
		"ro:/usr/share/ca-certificates",

		"ro:/var",

		"ro:/lib",

		"ro:/lib64",

		"ro:/bin",

		"ro:/etc"
	],
	"envs": {}
}
