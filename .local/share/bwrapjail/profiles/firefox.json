		"rw:$HOME/.config/pulse/cookie",
		"rw:$HOME/.config/mozilla/firefox",
		"rw:$HOME/.local/share/flatpak",
		"rw:$HOME/.config/gtk-3.0",
		"rw:$HOME/Downloads",
		"rw:$HOME/.local/bin/firefox",
		"rw:$HOME/.local/share/applications/firefox.desktop",
		"rw:$HOME/.config/mimeapps.list",
		"rw:$HOME/.pulse-cookie",
		"rw:$HOME/.local/share/applications/wine/Programs",
		"rw:$HOME/.config/dconf/user",
		"rw:$HOME/.local/share/mime",
		"rw:$HOME/.local/share/icons",

		"ro:/usr/local/share/fonts",

		"ro:/bin/sh",
		"ro:/bin/firefox"
