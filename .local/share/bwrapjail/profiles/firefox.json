{
	"executable": "/usr/bin/firefox",
	"allow_network": true,
	"allow_audio": true,
	"graphics": {
		"allow_gpu": true,
		"allow_wayland": true,
		"allow_x11": true
	},
	"dbus": {
		"open_uri": false,
		"notifications": false,
		"screenshare": true,
		"file_chooser": false,
		"print": true,
		"media": true,
		"clipboard": true
	}
}
