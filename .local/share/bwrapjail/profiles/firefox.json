{
	"cmd": {
		"executable": "/usr/bin/firefox",
		"extra_args": []
	},
	"allow_network": true,
	"allow_audio": true,
	"graphics": {
		"allow_gpu": true,
		"allow_wayland": true,
		"allow_x11": true
	},
	"dbus": {
		"open_uri": true,
		"notifications": true,
		"screenshare": false,
		"file_chooser": true,
		"print": true,
		"media": true,
		"clipboard": true
	},
	"paths": [
		"ro:/usr/share/locale",
		"ro:/usr/share/pixmaps",
		"ro:/usr/share/fonts",
		"ro:/usr/share/fontconfig",
		"ro:/usr/share/xkeyboard-config-2",
		"ro:/usr/share/zoneinfo",
		"ro:/usr/share/glvnd",
		"ro:/usr/share/mime",
		"ro:/usr/share/applications/mimeinfo.cache",
		"ro:/usr/share/icons",
		"ro:/usr/share/ca-certificates",
		"ro:/usr/share/themes/Default/gtk-3.0",
		"ro:/usr/share/glib-2.0",
		"ro:/usr/share/gtk-3.0",

		"ro:/usr/lib",
		"ro:/usr/lib64",
		"ro:/usr/lib32",
		"ro:/lib",
		"ro:/lib64",

		"ro:/etc/host.conf",
		"ro:/etc/ld.so.conf",
		"ro:/etc/os-release",
		"ro:/etc/mailcap",
		"ro:/etc/ca-certificates",
		"ro:/etc/passwd",
		"ro:/etc/xdg",
		"ro:/etc/gai.conf",
		"ro:/etc/fonts",
		"ro:/etc/libva.conf",
		"ro:/etc/ld.so.conf.d/lib32-glibc.conf",
		"ro:/etc/hosts",
		"ro:/etc/ld.so.cache",
		"ro:/etc/group",
		"ro:/etc/resolv.conf",
		"ro:/etc/nsswitch.conf",
		"ro:/etc/localtime",
		"ro:/etc/mime.types",
		"ro:/etc/pulse/client.conf",

		"ro:/usr/bin/sh",
		"ro:/usr/bin/gtk-query-immodules-3.0",
		"ro:/usr/bin/firefox",
		"ro:/usr/bin/nologin",
		"ro:/usr/bin/true",
		"ro:/usr/bin/bash",

		"rw:/run/systemd/userdb/io.systemd.DynamicUser",
		"rw:/run/dbus/system_bus_socket",
		"rw:/run/user/1000/dconf/user",

		"ro:/var/cache/fontconfig",
