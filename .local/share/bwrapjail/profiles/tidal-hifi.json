{
	"cmd": {
		"executable": "/usr/bin/tidal-hifi",
		"extra_args": [
			"--enable-features=UseOzonePlatform",
			"--ozone-platform-hint=auto",
			"--enable-features=WaylandWindowDecorations"
		]
	},
	"allow_network": true,
	"allow_audio": true,
	"graphics": {
		"allow_gpu": true,
		"allow_wayland": true,
		"allow_x11": true
	},
	"dbus": {
		"open_uri": false,
		"notifications": true,
		"screenshare": false,
		"file_chooser": false,
		"print": false,
		"media": true,
		"clipboard": true
	},
	"paths": ["rw:$HOME/.config/tidal-hifi", "rw:$HOME/.cache/fontconfig"],
	"envs": {
		"HOME": "$HOME"
	}
}
