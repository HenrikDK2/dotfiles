{
	"executable": "/usr/bin/tidal-hifi",
	"allow_network": true,
	"allow_audio": true,
	"graphics": {
		"allow_gpu": true,
		"allow_wayland": true,
		"allow_x11": true
	},
	"dbus": {
		"open_uri": true,
		"notifications": true,
		"screenshare": true,
		"file_chooser": true,
		"print": true,
		"media": true,
		"clipboard": true
	},
	"paths": [
		"rw:$HOME/.config/tidal-hifi",
		"rw:$HOME/.cache/fontconfig",
		"rw:/var/cache/fontconfig"
	],
	"envs": {
		"HOME": "$HOME"
	}
}
