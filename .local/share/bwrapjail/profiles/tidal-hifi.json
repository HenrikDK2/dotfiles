{
	"cmd": {
		"executable": "/usr/bin/tidal-hifi",
		"extra_args": [
			"--enable-features=UseOzonePlatform",
			"--ozone-platform-hint=auto",
			"--enable-features=WaylandWindowDecorations"
		]
	},
	"allow_network": true,
	"allow_audio": true,
	"graphics": {
		"allow_gpu": true,
		"allow_wayland": true,
		"allow_x11": true
	},
	"dbus": {
		"open_uri": false,
		"notifications": false,
		"screenshare": false,
		"file_chooser": false,
		"print": false,
		"media": true,
		"clipboard": true
	},
	"paths": [
		"ro:/etc/fonts",
		"ro:/etc/host.conf",
		"ro:/etc/ca-certificates",
		"ro:/etc/resolv.conf",

		"rw:$HOME/.config/tidal-hifi",
		"rw:$HOME/.config/gtk-3.0",
		"rw:$HOME/.cache/fontconfig",

		"ro:/usr/lib",
		"ro:/usr/lib64",

		"ro:/usr/share/fonts",
		"ro:/usr/share/icons",
		"ro:/usr/share/cursors",
		"ro:/usr/share/ca-certificates",
		"ro:/usr/share/fontconfig",

		"ro:/usr/bin",
		"ro:/lib",

		"ro:/opt/tidal-hifi",
		"ro:/lib64"
	],
	"envs": {
		"HOME": "$HOME"
	}
}
