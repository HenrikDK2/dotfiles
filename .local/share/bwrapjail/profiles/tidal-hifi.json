{
	"cmd": {
		"executable": "/usr/bin/tidal-hifi",
		"extra_args": [
			"--enable-features=UseOzonePlatform",
			"--ozone-platform-hint=auto",
			"--enable-features=WaylandWindowDecorations"
		]
	},
	"allow_network": true,
	"allow_audio": true,
	"graphics": {
		"allow_gpu": true,
		"allow_wayland": true,
		"allow_x11": true
	},
	"dbus": {
		"open_uri": false,
		"notifications": true,
		"screenshare": false,
		"file_chooser": false,
		"print": false,
		"media": true,
		"clipboard": true
	},
	"paths": [
		"rw:$HOME/.config/tidal-hifi",
		"rw:$HOME/.cache/fontconfig",

		"rw:/var/cache/fontconfig",

		"rw:/usr/share/fontconfig",
		"ro:/usr/share/fonts",

		"ro:/usr/bin",
		"ro:/usr/lib",
		"ro:/usr/lib32",
		"ro:/usr/lib64",

		"ro:/opt/tidal-hifi",

		"ro:/lib",
		"ro:/lib64",
		"ro:/bin",
		"ro:/etc"
	],
	"envs": {
		"HOME": "$HOME"
	}
}
